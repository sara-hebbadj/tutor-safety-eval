# Variable names only. Real values go in "Portfolio Projects/.env" (two folders up), or in a local
# .env next to this file after a fresh clone. Never commit a .env file.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model IDs (provider/model), see https://openrouter.ai/models.
# MODEL_JUDGE must come from a different family than every tutor model under test (the runner checks).
MODEL_MAIN=
MODEL_CHEAP=
MODEL_JUDGE=
# Optional
REASONING_EFFORT=low
MAX_COST_PER_RUN_USD=3
TUTOR_EVAL_BUDGET_USD=2
DEMO_MESSAGE_LIMIT=20
